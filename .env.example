# Tiger Data (Tiger Cloud) Postgres connection string
# For chain mode: postgres://user:pass@host:port/tsdb?sslmode=require
DATABASE_URL=

# Claude is used when set; otherwise Gemini; otherwise offline fallback
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Claude is used when set; otherwise Gemini; otherwise offline fallback
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Gemini API key from aistudio.google.com (never commit the real one)
GEMINI_API_KEY=

# ElevenLabs API key (elevenlabs.io > Settings > API keys). Backend only: used to get signed
# URLs for the voice widget and for TTS. Never put it in a NEXT_PUBLIC_ variable.
ELEVENLABS_API_KEY=
# ID of the Solpouch agent (ElevenLabs > Agents > your agent)
ELEVENLABS_AGENT_ID=

# ElevenLabs: shared secret the voice agent's server tools send in the X-Solpouch-Secret header
# Existing ELEVENLABS_TOOL_SECRET is also accepted during migration.
VOICE_WEBHOOK_SECRET=

# Solana
SOLANA_RPC_URL=https://api.devnet.solana.com
VAULT_PROGRAM_ID=
TEST_USDC_MINT=
# Path to the AI agent keypair (can only call `pay`). Keep outside the repo.
AGENT_KEYPAIR_PATH=.keys/agent.json
# Demo only: the backend signs owner actions (create pouch, top up, freeze) with this key. In a real app the owner signs in their wallet.
OWNER_KEYPAIR_PATH=.keys/owner.json
# "mock" until the program is deployed, then "chain"
VAULT_MODE=mock
# Required for web/any-store pouch rules in chain mode. Use a real checkout wallet public key.
# Web search estimates are reference-only and cannot be paid through Solpouch.
CHECKOUT_PAY_TO=
# Read-only chain indexer: writes vault program events to Postgres (payments, vault_events) for /stats/spend.
# Runs only with VAULT_MODE=chain and DATABASE_URL set. Never signs. Poll interval backs up the log subscription.
ENABLE_INDEXER=false
INDEXER_POLL_MS=30000

# Google sign-in: OAuth Web client ID (console.cloud.google.com > Credentials). Public value, also used by the web app.
GOOGLE_CLIENT_ID=
# Secret that signs session and voice tokens (HMAC). Generate: openssl rand -hex 32. If unset, a random one is used per start.
SESSION_SECRET=
# Optional: existing pouches with no owner are assigned to this Google email at startup (Postgres only).
LEGACY_OWNER_EMAIL=

BACKEND_PORT=8787
NEXT_PUBLIC_BACKEND_URL=http://localhost:8787

# Only trust forwarding headers from these exact socket-peer IPs (comma separated).
# Leave empty for direct access. Restrict backend ingress to the configured proxy.
TRUSTED_PROXY_IPS=
# x-forwarded-for walks from the nearest proxy; cf-connecting-ip needs a proxy
# that replaces this header with a verified Cloudflare client address.
TRUSTED_PROXY_HEADER=x-forwarded-for
# Optional Instacart shopping-list links. These never submit or pay for orders.
INSTACART_API_KEY=
# Set production only with an explicitly configured production key.
INSTACART_ENV=dev
# Exact browser origins. Include the local preview port when testing.
WEB_ORIGINS=http://localhost:3000,https://solpouch.tech,https://www.solpouch.tech
# Postgres pool size (default 15).
PG_POOL_MAX=15
# Optional PEM CA file for the Postgres server; remote TLS certificates are always verified.
DATABASE_CA_CERT=
# Only for a localhost test database without TLS. Never enables remote plaintext.
DB_ALLOW_INSECURE_LOCAL=false
# Chain mode requires Postgres and supports devnet only. No startup transfers occur.
# Explicit development faucet: mint + deposit atomically. Default transfers existing tokens.
ENABLE_DEVNET_FAUCET=false
TOPUP_COOLDOWN_SECONDS=60

# Enable only after provider webhook headers use the wallet-bound secret dynamic variable.
# See voice/session-config.example.json. Keep false until the private agent bindings are verified.
ELEVENLABS_SECURE_TOOLS_CONFIGURED=false

# Wallet funding: sandbox only. Mainnet funding is blocked in code.
# Optional separate Postgres for funding when VAULT_MODE=mock. Do not put real
# balances in the mock pouch store. Uses verified TLS unless explicitly local.
FUNDING_DATABASE_URL=
TRANSAK_ENV=staging
TRANSAK_API_KEY=
# Server-only partner access token; also verifies provider webhook signatures.
TRANSAK_ACCESS_TOKEN=
# Domain registered in the Transak partner dashboard.
TRANSAK_REFERRER_DOMAIN=
# Enable only routes verified with your partner account. Empty disables all.
# Example after staging verification: US:BUY,CA:BUY,US:SELL,CA:SELL
TRANSAK_ENABLED_CAPABILITIES=

# Opt-in Stripe TEST Checkout -> Solpouch devnet test-USDC. Transak remains the default.
FUNDING_PROVIDER=transak
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
FUNDING_USD_PER_CAD=0.73
STRIPE_DEMO_MINT=0
# Optional separate authority; defaults to OWNER_KEYPAIR_PATH, then .keys/owner.json.
STRIPE_MINT_KEYPAIR_PATH=
# Trusted return origin; use your isolated localhost preview for local Checkout tests.
FUNDING_RETURN_ORIGIN=https://solpouch.tech
# Separate explicit devnet-only retailer demo quote, never a real retailer order.
DEMO_RETAILER_PAYMENTS=0

# ES256 key Privy uses to verify users (node apps/backend/scripts/privy-key.mjs)
PRIVY_JWT_PRIVATE_KEY=
