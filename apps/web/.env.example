# Copy to apps/web/.env.local or set in your frontend hosting environment.
# These settings contain no secrets. Keep Gemini/other API keys on the backend.
NEXT_PUBLIC_BACKEND_URL=http://localhost:8787

# Set to the actual deployed origin, e.g. your HTTPS domain. Leave blank locally.
SOLPOUCH_SITE_URL=

# Only enable for an intentionally public demo. Orders and pouches stay noindex.
SOLPOUCH_ALLOW_INDEXING=false
