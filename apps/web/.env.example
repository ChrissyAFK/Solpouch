# Copy to apps/web/.env.local or set in your frontend hosting environment.
# These settings contain no secrets. Keep Gemini/other API keys on the backend.
NEXT_PUBLIC_BACKEND_URL=http://localhost:8787

# Set to the actual deployed origin, e.g. your HTTPS domain. Leave blank locally.
SOLPOUCH_SITE_URL=

# Enable for the public landing page. Dashboard, orders and pouches stay noindex.
SOLPOUCH_ALLOW_INDEXING=false

# Google OAuth Web client ID for sign-in (public, not a secret). Create it in Google Cloud Console
# and add your site origin (e.g. http://localhost:3000) under Authorized JavaScript origins.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Optional in-browser Solana wallet via Privy (public app id). Leave blank to disable; nothing Privy loads then.
NEXT_PUBLIC_PRIVY_APP_ID=
# Solana cluster for the built-in wallet (default devnet). RPC defaults to the public devnet endpoint.
NEXT_PUBLIC_SOLANA_CLUSTER=devnet
NEXT_PUBLIC_SOLANA_RPC_URL=
